*D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *D *